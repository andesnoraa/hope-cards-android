<string name="settings_intro">Hope Cards നിങ്ങൾക്ക് അനുയോജ്യമാക്കൂ.</string><string name="settings_appearance">കാഴ്ച</string><string name="settings_theme">തീം</string><string name="settings_draw_button">കാർഡ് എടുക്കാനുള്ള ബട്ടൺ</string><string name="settings_draw_button_body">ബട്ടൺ കാണിക്കാം, അല്ലെങ്കിൽ കാർഡ് കെട്ടിൽ നേരിട്ട് തൊടാം.</string><string name="settings_bible_translation">ബൈബിൾ പരിഭാഷ</string><string name="settings_daily_hope">ഇന്നത്തെ പ്രത്യാശ</string><string name="settings_background_music">പശ്ചാത്തല സംഗീതം</string><string name="settings_background_music_body">ഇന്നത്തെ പ്രത്യാശ വായിക്കുമ്പോൾ ശാന്തമായ സംഗീതം കേൾക്കൂ.</string><string name="settings_daily_reminder">ദിവസേന ഓർമ്മപ്പെടുത്തൽ</string><string name="settings_daily_reminder_body">ദിവസവും ഒരു വചനം വായിക്കാൻ ഓർമ്മപ്പെടുത്തൽ ലഭിക്കും.</string><string name="settings_reminder_time">ഓർമ്മപ്പെടുത്തൽ സമയം</string><string name="settings_interaction">ഉപയോഗം</string><string name="settings_haptics">സ്പർശ പ്രതികരണം</string><string name="settings_haptics_body">കാർഡ് എടുക്കുമ്പോഴും സൂക്ഷിക്കുമ്പോഴും നേരിയ വിറയൽ നൽകും.</string>
<string name="settings_backup_restore">ബാക്കപ്പും പുനഃസ്ഥാപിക്കലും</string><string name="settings_backup_now">ഇപ്പോൾ ബാക്കപ്പ് ചെയ്യുക</string><string name="settings_backup_now_modern_body">പ്രിയ വചനങ്ങൾ, കുറിപ്പുകൾ, ക്രമീകരണങ്ങൾ എന്നിവ Downloads/Hope Cards Backups-ൽ സൂക്ഷിക്കുക.</string><string name="settings_backup_now_legacy_body">പ്രിയ വചനങ്ങൾ, കുറിപ്പുകൾ, ക്രമീകരണങ്ങൾ എന്നിവ Hope Cards Backups-ൽ സൂക്ഷിക്കുക.</string><string name="settings_cloud_backup">Google Drive / ക്ലൗഡ് ബാക്കപ്പ്</string><string name="settings_cloud_backup_body">ബാക്കപ്പിനുള്ള Drive അക്കൗണ്ടും ഫോൾഡറും ഉറപ്പാക്കുകയോ മാറ്റുകയോ ചെയ്യുക.</string><string name="settings_export_backup">ബാക്കപ്പ് പുറത്തേക്ക് സൂക്ഷിക്കുക</string><string name="settings_export_backup_body">Hope Cards-ന് പുറത്തേക്ക് ഒരു പകർപ്പ് സൂക്ഷിക്കുകയോ പങ്കിടുകയോ ചെയ്യാം. ബാക്കപ്പ് ഫയൽ എൻക്രിപ്റ്റ് ചെയ്തതല്ല.</string><string name="settings_restore_backup">ബാക്കപ്പ് പുനഃസ്ഥാപിക്കുക</string><string name="settings_restore_backup_body">ഒരു ബാക്കപ്പ് ഫയൽ തിരഞ്ഞെടുക്കൂ. അടുത്ത തവണ അതിന്റെ സ്ഥലം ഓർക്കും.</string><string name="theme_picker_body">ശാന്തമായി നിൽക്കാനും ചിന്തിക്കാനും സഹായിക്കുന്ന ഭാവം തിരഞ്ഞെടുക്കൂ.</string><string name="translation_picker_body">Hope Cards-ൽ ഉപയോഗിക്കേണ്ട ബൈബിൾ പരിഭാഷ തിരഞ്ഞെടുക്കൂ.</string><string name="close_selector">തിരഞ്ഞെടുപ്പ് അടയ്ക്കുക</string><string name="close_reminder_selector">സമയം തിരഞ്ഞെടുക്കൽ അടയ്ക്കുക</string><string name="increase_reminder">%1$s കൂട്ടുക</string><string name="decrease_reminder">%1$s കുറയ്ക്കുക</string><string name="hour">മണിക്കൂർ</string><string name="minute">മിനിറ്റ്</string><string name="selected">തിരഞ്ഞെടുത്തു</string>
<string name="theme_classic">ക്ലാസിക്</string><string name="theme_classic_desc">ഇളം ക്രീം, നേവി, സ്വർണം.</string><string name="theme_rose">റോസ് പ്രഭാതം</string><string name="theme_rose_desc">മൃദുവായ റോസ്, പ്ലം, ഷാംപെയിൻ.</string><string name="theme_olive">ഒലിവ് തോട്ടം</string><string name="theme_olive_desc">കടും ഒലിവ്, ലിനൻ, പിത്തളം.</string><string name="theme_evergreen">എവർഗ്രീൻ</string><string name="theme_evergreen_desc">തെളിഞ്ഞ വെള്ള, പച്ച ലെതർ, സ്വർണം.</string><string name="theme_water">ശാന്തജലം</string><string name="theme_water_desc">കടും ടീൽ, തെളിഞ്ഞ നീല.</string><string name="theme_midnight">അർദ്ധരാത്രി</string><string name="theme_midnight_desc">പുരാതന സ്വർണ അലങ്കാരമുള്ള കറുത്ത കാർഡുകൾ.</string><string name="theme_coastal">തീരദേശ ലിനൻ</string><string name="theme_coastal_desc">സ്വാഭാവിക ലിനൻ, ടീൽ, ടെറാക്കോട്ട.</string><string name="theme_lavender">ശാന്തമായ ലാവെൻഡർ</string><string name="theme_lavender_desc">മൃദുവായ ലാവെൻഡർ, പ്ലം, മങ്ങിയ ലൈലാക്.</string><string name="theme_vintage">വിന്റേജ് പൈതൃകം</string><string name="theme_vintage_desc">ഐവറി, കറുത്ത ലെതർ, പുരാതന സ്വർണം.</string>
