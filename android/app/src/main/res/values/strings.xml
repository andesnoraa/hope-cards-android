    <string name="privacy_title">Your privacy matters</string><string name="privacy_intro">Hope Cards keeps your verses, favorites, and journal on your device. No account is required.</string><string name="privacy_effective">Effective 6 September 2026</string>
    <string name="privacy_information">Information We Collect</string><string name="privacy_information_1">Hope Cards does not ask for your name, email address, phone number, contacts, precise location, photos, or microphone access.</string><string name="privacy_information_2">Google Mobile Ads and Google Play may process limited device, consent, advertising, diagnostic, and purchase information to provide ads and verify Remove Ads ownership.</string>
    <string name="privacy_device">Data Stored on Your Device</string><string name="privacy_device_1">Favorites, journal entries, the selected Bible translation, theme, reminder time, music and haptic preferences, and other settings are stored on your device.</string><string name="privacy_device_2">Journal entries are not sent to Hope Cards or used for advertising. They leave your device only when you choose to create a local or cloud backup.</string><string name="privacy_device_3">Removing the app may remove this data unless you exported a backup.</string>
    <string name="privacy_permissions">Reminders and Permissions</string><string name="privacy_permissions_1">If you enable Daily Hope reminders, the app requests notification permission and schedules one battery-conscious reminder on your device.</string><string name="privacy_permissions_2">Background music is included with the app and does not require microphone access.</string>
    <string name="privacy_sharing">Sharing and Backups</string><string name="privacy_sharing_1">Sharing a verse or backup opens Android’s sharing controls. Hope Cards does not record who you share with or which service you choose.</string><string name="privacy_sharing_2">Backup files contain favorites, journal entries, and settings. They are readable JSON and should be stored somewhere you trust.</string><string name="privacy_sharing_3">If you choose Google Drive or another cloud folder, Android grants Hope Cards access only to that selected folder—not to your Google account or unrelated Drive files.</string>
    <string name="privacy_advertising">Advertising</string><string name="privacy_advertising_1">Hope Cards uses Google Mobile Ads for adaptive banners and occasional full-screen ads. Google’s consent tools are shown where required.</string><string name="privacy_advertising_2">Your journal text and saved verse content are not sent for ad targeting.</string>
    <string name="privacy_purchase">Remove Ads Purchase</string><string name="privacy_purchase_1">The optional one-time Remove Ads purchase is processed directly by Google Play Billing. Hope Cards checks purchase ownership and does not receive your full payment-card details.</string><string name="privacy_children">Children’s Privacy</string><string name="privacy_children_1">Hope Cards is intended for a general audience. We do not knowingly collect personal information directly from children.</string><string name="privacy_updates">Policy Updates</string><string name="privacy_updates_1">We may update this policy when the app or its services change. The effective date above shows when it was last revised.</string>
    <string name="about_tagline">Find timely encouragement in Scripture, save meaningful verses, and share hope with others.</string><string name="about_features">Features</string><string name="about_why">Why Hope Cards</string><string name="about_story_1">Hope Cards was created during a difficult season when Scripture brought strength.</string><string name="about_story_2">Its purpose is simple: to help someone facing a difficult moment find a timely verse, a quiet reminder, and renewed hope.</string><string name="about_credits">Credits</string><string name="about_public_domain">Public domain</string><string name="about_developed_with">Developed with</string><string name="about_by">by</string>
